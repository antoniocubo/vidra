# Ambiente do teste de ponta a ponta (npm run e2e copia para .env.e2e).
APP_NAME=Vidra
APP_ENV=local
APP_KEY=base64:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8124
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
BCRYPT_ROUNDS=4
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=single
LOG_LEVEL=debug

# Arquivo dedicado: o npm run e2e recria ele a cada execução.
DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="laudos@vidralab.com.br"
MAIL_FROM_NAME="Vidra"

# Porta 3001 do infra/docker-compose.yml (no CI o serviço também é mapeado para 3001).
GOTENBERG_URL=http://127.0.0.1:3001
VIDRA_URL_LAUDO=http://localhost:8124/laudo
ASAAS_API_KEY=
