# Vidra em produção. Copie para platform/.env no servidor (cp .env.production.example .env)
# e preencha. Nunca versione o .env. Este mesmo arquivo alimenta a aplicação e o docker-compose.

# --- Aplicação ---
APP_NAME=Vidra
APP_ENV=production
APP_KEY=                 # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://app.vidralab.com.br
APP_TIMEZONE=UTC
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# E-mail do certificado TLS (Let's Encrypt avisa aqui quando algo vencer)
ACME_EMAIL=ti@vidralab.com.br

# Superfícies: cada uma num subdomínio, todas na mesma aplicação
# Um host por superfície: cada um só responde às próprias rotas (routes/web.php).
VIDRA_DOMINIO_SITE=vidralab.com.br
VIDRA_DOMINIO_APP=app.vidralab.com.br
VIDRA_DOMINIO_VET=vet.vidralab.com.br
VIDRA_DOMINIO_LAUDO=laudo.vidralab.com.br
VIDRA_URL_LAUDO=https://laudo.vidralab.com.br
VIDRA_URL_VET=https://vet.vidralab.com.br

# --- Banco (Postgres 17 no compose, host "postgres") ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vidra
# A aplicação entra como vidra_app: sem superusuário, sem BYPASSRLS, não é dona das tabelas.
# É isso que faz o RLS valer. Senha longa e aleatória (openssl rand -base64 32).
DB_USERNAME=vidra_app
DB_PASSWORD=
# Conexão de sistema e migrations: usuário vidra, dono das tabelas.
DB_SISTEMA_CONNECTION=pgsql_sistema
DB_SISTEMA_USERNAME=vidra
DB_SISTEMA_PASSWORD=
# Superusuário do Postgres, só para administração. A aplicação não usa; guarde fora do servidor se puder.
POSTGRES_SUPERUSER_PASSWORD=

# --- Sessão ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Deixe SESSION_DOMAIN vazio: o cookie vale só para o host que o criou. É o certo aqui, porque
# laboratório (app.), veterinário (vet.) e tutor (laudo.) são superfícies separadas e uma sessão
# aberta em uma não deve valer nas outras. Só use ".vidralab.com.br" se um dia quiser login único
# entre subdomínios (e aceite que o cookie passa a ir para todos).
# SESSION_DOMAIN=

# --- Redis (host "redis", dentro da rede do compose) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Horizon (painel em app.vidralab.com.br/horizon) ---
# E-mails que podem abrir o painel, separados por vírgula. Vazio = ninguém.
HORIZON_EMAILS=

# --- PDF do laudo (Gotenberg, só na rede interna) ---
GOTENBERG_URL=http://gotenberg:3000

# --- E-mail: Amazon SES ---
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="laudos@vidralab.com.br"
MAIL_FROM_NAME="Vidra"
# Região onde o domínio foi verificado no SES (sa-east-1 ou us-east-1)
AWS_SES_REGION=sa-east-1

# --- Arquivos dos laudos: S3 privado em sa-east-1 ---
LAUDOS_DISK=s3
AWS_ACCESS_KEY_ID=       # usuário IAM com acesso só ao bucket (ver docs/deploy.md); também envia pelo SES
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
# Região do bucket dos laudos (padrão sa-east-1)
AWS_LAUDOS_REGION=sa-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Backup (bucket S3 separado do dos laudos; usuário IAM próprio, só escrita) ---
BACKUP_S3_BUCKET=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=sa-east-1

# --- Sentry (erros). Sem DSN, nada é enviado. ---
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
# Dados de tutor e animal são pessoais (LGPD): não enviar IP, cookies nem usuário.
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Cobrança dos laboratórios: Asaas ---
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox   # sandbox | producao
ASAAS_WEBHOOK_TOKEN=     # o mesmo token cadastrado no webhook do Asaas

VITE_APP_NAME="${APP_NAME}"
